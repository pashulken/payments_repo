{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qa.local/schemas/error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {
          "enum": [
            "validation_error",
            "invalid_state",
            "invalid_request",
            "not_found",
            "server_error"
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}

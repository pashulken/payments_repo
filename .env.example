# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored — never commit real keys.

# Stripe test mode secret key (sk_test_...)
# Get yours at: https://dashboard.stripe.com/test/apikeys
# Used by: lesson12 live contract tests
STRIPE_TEST_KEY=sk_test_YOUR_KEY

# WireMock base URL
# Start WireMock: docker run -d --name wiremock -p 8080:8080 wiremock/wiremock:3.3.1
# Used by: lesson04 WireMock integration tests
WIREMOCK_URL=http://localhost:8080

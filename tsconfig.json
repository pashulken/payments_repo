{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "declaration": true
  },
  "include": ["lessons/**/*.ts"],
  "exclude": ["node_modules", "dist", "lessons/lesson06-webhooks/webhook-template"]
}

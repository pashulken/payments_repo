{
  "name": "merchant-payment-service-qa",
  "version": "1.0.0",
  "description": "Playwright QA suite for the Merchant Payment Service course project",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:course": "playwright test",
    "test:course:api": "playwright test --project=api",
    "test:course:ci": "playwright test --project=api --grep-invert @stripe",
    "test:course:contract": "playwright test --project=api --grep @contract",
    "test:course:e2e": "playwright test --project=e2e",
    "test:course:report": "playwright show-report",
    "typecheck:course": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "payment-testing-course",
  "version": "1.0.0",
  "description": "Курс: Тестування платіжних систем",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:course": "playwright test",
    "test:course:api": "playwright test --project=api",
    "test:course:ci": "playwright test --project=api --grep-invert @stripe",
    "test:course:e2e": "playwright test --project=e2e",
    "test:course:report": "playwright show-report",
    "typecheck:course": "tsc --noEmit -p tsconfig.playwright.json",
    "test:velocity": "jest --runInBand --runTestsByPath lessons/lesson09-antifraud/velocity-buggy.unit.test.js",
    "test:unit": "jest \"\\.unit\\.test\\.(ts|js)$\"",
    "test:integration": "jest \"\\.integration\\.test\\.ts$\"",
    "test:contract": "jest \"\\.contract\\.test\\.ts$\"",
    "test:contract:live": "jest \"\\.contract-live\\.test\\.ts$\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "dotenv": "^18.0.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "axios": "^1.6.0",
    "stripe": "^14.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
